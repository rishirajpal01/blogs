{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rishirajpal-blogs",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "blogs.rishirajpal.com",
      "custom_domain": true
    }
  ]
}
